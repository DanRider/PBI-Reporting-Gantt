table Calendar
	lineageTag: 32e1261c-05ce-45ca-9fb1-96e4b0f399d3
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: General Date
		lineageTag: e783c992-8548-475d-b70e-2d5709788f5b
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 9b860df1-e7f5-4118-8910-0b6fa8e4e394
		summarizeBy: none
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fe8d48ba-5a83-4a5e-b90e-3ec73ee3eb3f
		summarizeBy: none
		sourceColumn: [Quarter Number]

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 906f3877-da58-4845-bd58-6850dc80e500
		summarizeBy: none
		sourceColumn: [Quarter]
		sortByColumn: 'Quarter Number'

		annotation SummarizationSetBy = Automatic

	column Year-Quarter
		dataType: string
		lineageTag: b7807fac-722a-439b-b1b1-08f3471972fc
		summarizeBy: none
		sourceColumn: [Year-Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3faaeb88-c435-4fe0-8869-7872c76b005b
		summarizeBy: none
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 5d314ac4-5055-4ae4-883d-f2e43fab7506
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 10, 1), DATE(2027, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter Number", QUARTER([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Year-Quarter", YEAR([Date]) & " Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM")
				)

	annotation PBI_ResultType = Table

