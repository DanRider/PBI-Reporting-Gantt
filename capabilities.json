{
    "dataRoles": [
        {
            "name": "activity",
            "displayName": "Activity",
            "kind": "Grouping",
            "description": "The bar's identity. Each unique value renders as one horizontal bar (e.g., a project task, a campaign phase, a product release, a clinical trial)."
        },
        {
            "name": "area",
            "displayName": "Swim Lane",
            "kind": "Grouping",
            "description": "Optional grouping that segments bars into swim lanes (e.g., team, department, workstream, portfolio area)."
        },
        {
            "name": "startDate",
            "displayName": "Start Date",
            "kind": "Grouping",
            "description": "When the bar starts. Date column."
        },
        {
            "name": "endDate",
            "displayName": "End Date",
            "kind": "Grouping",
            "description": "When the bar ends. Date column."
        },
        {
            "name": "milestoneActivity",
            "displayName": "Milestone Activity",
            "kind": "Grouping",
            "description": "FK to the parent activity name. Each milestone attaches to the bar with the matching name."
        },
        {
            "name": "milestoneDate",
            "displayName": "Milestone Date",
            "kind": "Grouping",
            "description": "When the milestone marker is placed on its parent bar."
        },
        {
            "name": "milestoneType",
            "displayName": "Milestone Type",
            "kind": "Grouping",
            "description": "Marker classifier — distinct values appear as one slice each in the Format pane (color/symbol/size/visibility per type)."
        },
        {
            "name": "milestoneLabel",
            "displayName": "Milestone Label",
            "kind": "Grouping",
            "description": "Optional milestone text (nullable). Shown next to the marker per Label Position."
        },
        {
            "name": "labelPosition",
            "displayName": "Label Position",
            "kind": "Grouping",
            "description": "L | R | none. Author-controlled position of the label relative to the marker."
        }
    ],
    "objects": {
        "title": {
            "displayName": "Title",
            "description": "Custom visual title rendered at the top of the chart. Disable PBI's native title (in General formatting) when using this.",
            "properties": {
                "show":       { "displayName": "Show",       "type": { "bool": true } },
                "text":       { "displayName": "Text",       "type": { "text": true } },
                "fontFamily": { "displayName": "Font",       "type": { "formatting": { "fontFamily": true } } },
                "fontSize":   { "displayName": "Size",       "type": { "formatting": { "fontSize": true } } },
                "bold":       { "displayName": "Bold",       "type": { "bool": true } },
                "italic":     { "displayName": "Italic",     "type": { "bool": true } },
                "underline":  { "displayName": "Underline",  "type": { "bool": true } },
                "color":      { "displayName": "Color",      "type": { "fill": { "solid": { "color": true } } } },
                "alignment":  { "displayName": "Alignment", "type": { "enumeration": [
                    { "value": "left",   "displayName": "Left" },
                    { "value": "center", "displayName": "Center" },
                    { "value": "right",  "displayName": "Right" }
                ]}}
            }
        },
        "layout": {
            "displayName": "Layout",
            "description": "Outer margins around the chart, as percentages of viewport.",
            "properties": {
                "topMarginPercent":    { "displayName": "Top margin (%)",    "type": { "numeric": true } },
                "bottomMarginPercent": { "displayName": "Bottom margin (%)", "type": { "numeric": true } },
                "leftMarginPercent":   { "displayName": "Left margin (%)",   "type": { "numeric": true } },
                "rightMarginPercent":  { "displayName": "Right margin (%)",  "type": { "numeric": true } }
            }
        },
        "milestones": {
            "displayName": "Milestones",
            "description": "Marker + label controls. One subgroup per distinct Milestone Type value with color/symbol/size/visibility, plus shared label-styling controls.",
            "properties": {
                "fill":           { "displayName": "Color",       "type": { "fill": { "solid": { "color": true } } } },
                "symbol": {
                    "displayName": "Symbol",
                    "type": { "enumeration": [
                        { "value": "star",     "displayName": "Star" },
                        { "value": "circle",   "displayName": "Circle" },
                        { "value": "triangle", "displayName": "Triangle" },
                        { "value": "square",   "displayName": "Square" },
                        { "value": "diamond",  "displayName": "Diamond" }
                    ]}
                },
                "size":           { "displayName": "Size (px)",    "type": { "numeric": true } },
                "showMarker":     { "displayName": "Show markers", "type": { "bool": true } },
                "showLabel":      { "displayName": "Show labels",  "type": { "bool": true } },
                "hoverExpansion": { "displayName": "Hover target expansion (%)", "type": { "numeric": true } },
                "labelOverflow":  { "displayName": "Label overflow", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide colliding" },
                    { "value": "overflow", "displayName": "Show all (may overlap)" }
                ]}},
                "labelColor":      { "displayName": "Label color",       "type": { "fill": { "solid": { "color": true } } } },
                "labelFontFamily": { "displayName": "Label font",        "type": { "formatting": { "fontFamily": true } } },
                "labelFontSize":   { "displayName": "Label size",        "type": { "formatting": { "fontSize": true } } },
                "labelBold":       { "displayName": "Label bold",        "type": { "bool": true } },
                "labelItalic":     { "displayName": "Label italic",      "type": { "bool": true } },
                "labelUnderline":  { "displayName": "Label underline",   "type": { "bool": true } }
            }
        },
        "activityLabels": {
            "displayName": "Activity Labels",
            "properties": {
                "show":                       { "displayName": "Show",                          "type": { "bool": true } },
                "activityLabelWidthPercent":  { "displayName": "Label column width (%)",        "type": { "numeric": true } },
                "wrapText":                   { "displayName": "Wrap (2 lines)",                "type": { "bool": true } },
                "overflowBehavior": { "displayName": "When text doesn't fit", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide" },
                    { "value": "overflow", "displayName": "Show (may overflow)" }
                ]}},
                "fillMode": { "displayName": "Color mode", "type": { "enumeration": [
                    { "value": "grey", "displayName": "Dark grey" },
                    { "value": "area", "displayName": "Swim lane color" }
                ]}},
                "customColor":  { "displayName": "Custom color", "type": { "fill": { "solid": { "color": true } } } },
                "fontFamily":   { "displayName": "Font",        "type": { "formatting": { "fontFamily": true } } },
                "fontSize":     { "displayName": "Size",        "type": { "formatting": { "fontSize": true } } },
                "bold":         { "displayName": "Bold",        "type": { "bool": true } },
                "italic":       { "displayName": "Italic",      "type": { "bool": true } },
                "underline":    { "displayName": "Underline",   "type": { "bool": true } }
            }
        },
        "swimlanes": {
            "displayName": "Swim Lanes",
            "description": "Width, label styling, and per-swim-lane color overrides — all consolidated here. One color picker appears per distinct Swim Lane value found in your data.",
            "properties": {
                "show":                  { "displayName": "Show",                "type": { "bool": true } },
                "swimLaneWidthPercent":  { "displayName": "Swim lane width (%)", "type": { "numeric": true } },
                "railAlignment": {
                    "displayName": "Rail alignment relative to label",
                    "type": { "enumeration": [
                        { "value": "left",   "displayName": "Left of label" },
                        { "value": "center", "displayName": "Bisect label (center)" },
                        { "value": "right",  "displayName": "Right of label" }
                    ]}
                },
                "wrapText":              { "displayName": "Wrap labels",         "type": { "bool": true } },
                "labelColor":            { "displayName": "Label color (default = swim lane color)", "type": { "fill": { "solid": { "color": true } } } },
                "useAreaColor":          { "displayName": "Use swim lane color for label", "type": { "bool": true } },
                "fontFamily":            { "displayName": "Font",                "type": { "formatting": { "fontFamily": true } } },
                "fontSize":              { "displayName": "Size",                "type": { "formatting": { "fontSize": true } } },
                "bold":                  { "displayName": "Bold",                "type": { "bool": true } },
                "italic":                { "displayName": "Italic",              "type": { "bool": true } },
                "underline":             { "displayName": "Underline",           "type": { "bool": true } },
                "fill":                  { "displayName": "Color",               "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "legend": {
            "displayName": "Legend",
            "properties": {
                "show":       { "displayName": "Show (upper-left)", "type": { "bool": true } },
                "labelColor": { "displayName": "Label color",       "type": { "fill": { "solid": { "color": true } } } },
                "fontFamily": { "displayName": "Font",              "type": { "formatting": { "fontFamily": true } } },
                "fontSize":   { "displayName": "Size",              "type": { "formatting": { "fontSize": true } } },
                "bold":       { "displayName": "Bold",              "type": { "bool": true } },
                "italic":     { "displayName": "Italic",            "type": { "bool": true } },
                "underline":  { "displayName": "Underline",         "type": { "bool": true } }
            }
        },
        "timeAxis": {
            "displayName": "Time Axis",
            "description": "Three hierarchy levels — Year, Quarter, Month. Each level can be toggled on/off. Quarter and Month tick boundaries can also render vertical gridlines through the chart body with their own color, opacity, and line style.",
            "properties": {
                "chevronStyle": {
                    "displayName": "Chevron style",
                    "type": { "enumeration": [
                        { "value": "nested",    "displayName": "Nested arrow" },
                        { "value": "pentagon",  "displayName": "Pentagon" },
                        { "value": "rectangle", "displayName": "Rectangle" }
                    ]}
                },
                "showYear":                { "displayName": "Show Year",                "type": { "bool": true } },
                "yearFill":                { "displayName": "Year chevron color",       "type": { "fill": { "solid": { "color": true } } } },
                "showQuarter":             { "displayName": "Show Quarter",             "type": { "bool": true } },
                "quarterFill":             { "displayName": "Quarter chevron color",    "type": { "fill": { "solid": { "color": true } } } },
                "showMonth":               { "displayName": "Show Month",               "type": { "bool": true } },
                "monthFill":               { "displayName": "Month chevron color",      "type": { "fill": { "solid": { "color": true } } } },
                "showQuarterGridlines":    { "displayName": "Show quarter gridlines",    "type": { "bool": true } },
                "quarterGridlineColor":    { "displayName": "Quarter gridline color",    "type": { "fill": { "solid": { "color": true } } } },
                "quarterGridlineOpacityPct":{ "displayName": "Quarter gridline opacity (%)","type": { "numeric": true } },
                "quarterGridlineStyle":    { "displayName": "Quarter gridline style",    "type": { "enumeration": [
                    { "value": "solid",  "displayName": "Solid" },
                    { "value": "dashed", "displayName": "Dashed" },
                    { "value": "dotted", "displayName": "Dotted" }
                ]}},
                "showMonthGridlines":      { "displayName": "Show month gridlines",     "type": { "bool": true } },
                "monthGridlineColor":      { "displayName": "Month gridline color",     "type": { "fill": { "solid": { "color": true } } } },
                "monthGridlineOpacityPct": { "displayName": "Month gridline opacity (%)","type": { "numeric": true } },
                "monthGridlineStyle":      { "displayName": "Month gridline style",     "type": { "enumeration": [
                    { "value": "solid",  "displayName": "Solid" },
                    { "value": "dashed", "displayName": "Dashed" },
                    { "value": "dotted", "displayName": "Dotted" }
                ]}},
                "showTodayLine":           { "displayName": "TODAY line",               "type": { "bool": true } },
                "showTodayLabel":          { "displayName": "TODAY label",              "type": { "bool": true } },
                "todayLabelColor":         { "displayName": "TODAY color",              "type": { "fill": { "solid": { "color": true } } } },
                "showPastShading":         { "displayName": "Past shading",             "type": { "bool": true } },
                "pastShadingColor":        { "displayName": "Past shading color",       "type": { "fill": { "solid": { "color": true } } } },
                "pastShadingOpacityPct":   { "displayName": "Past shading opacity (%)", "type": { "numeric": true } },
                "showFutureShading":       { "displayName": "Future shading",           "type": { "bool": true } },
                "futureShadingColor":      { "displayName": "Future shading color",     "type": { "fill": { "solid": { "color": true } } } },
                "futureShadingOpacityPct": { "displayName": "Future shading opacity (%)","type": { "numeric": true } },
                "fontFamily":              { "displayName": "Font",                     "type": { "formatting": { "fontFamily": true } } },
                "fontSize":                { "displayName": "Size",                     "type": { "formatting": { "fontSize": true } } },
                "bold":                    { "displayName": "Bold",                     "type": { "bool": true } },
                "italic":                  { "displayName": "Italic",                   "type": { "bool": true } },
                "underline":               { "displayName": "Underline",                "type": { "bool": true } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "activity":          { "max": 1 },
                    "area":              { "max": 1 },
                    "startDate":         { "max": 1 },
                    "endDate":           { "max": 1 },
                    "milestoneActivity": { "max": 1 },
                    "milestoneDate":     { "max": 1 },
                    "milestoneType":     { "max": 1 },
                    "milestoneLabel":    { "max": 1 },
                    "labelPosition":     { "max": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "activity" } },
                        { "for": { "in": "area" } },
                        { "for": { "in": "startDate" } },
                        { "for": { "in": "endDate" } },
                        { "for": { "in": "milestoneActivity" } },
                        { "for": { "in": "milestoneDate" } },
                        { "for": { "in": "milestoneType" } },
                        { "for": { "in": "milestoneLabel" } },
                        { "for": { "in": "labelPosition" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": { "count": 5000 }
                    }
                }
            }
        }
    ],
    "supportsHighlight": false,
    "supportsLandingPage": false,
    "supportsMultiVisualSelection": false,
    "privileges": []
}
