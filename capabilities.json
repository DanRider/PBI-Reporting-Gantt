{
    "dataRoles": [
        {
            "name": "activity",
            "displayName": "Activity",
            "kind": "Grouping",
            "description": "The bar's identity. Each unique value renders as one horizontal bar (e.g., a project task, a campaign phase, a product release, an audit cycle)."
        },
        {
            "name": "area",
            "displayName": "Swim Lane",
            "kind": "Grouping",
            "description": "Optional grouping that segments bars into swim lanes (e.g., team, department, workstream, portfolio area)."
        },
        {
            "name": "startDate",
            "displayName": "Start Date",
            "kind": "Grouping",
            "description": "When the bar starts. Date column."
        },
        {
            "name": "endDate",
            "displayName": "End Date",
            "kind": "Grouping",
            "description": "When the bar ends. Date column."
        },
        {
            "name": "milestoneActivity",
            "displayName": "Milestone Activity",
            "kind": "Grouping",
            "description": "FK to the parent activity name. Each milestone attaches to the bar with the matching name."
        },
        {
            "name": "milestoneDate",
            "displayName": "Milestone Date",
            "kind": "Grouping",
            "description": "When the milestone marker is placed on its parent bar."
        },
        {
            "name": "milestoneType",
            "displayName": "Milestone Type",
            "kind": "Grouping",
            "description": "Marker classifier — distinct values appear as one slice each in the Format pane (color/symbol/size/visibility per type)."
        },
        {
            "name": "milestoneLabel",
            "displayName": "Milestone Label",
            "kind": "Grouping",
            "description": "Optional milestone text (nullable). Shown next to the marker per Label Position."
        },
        {
            "name": "labelPosition",
            "displayName": "Label Position",
            "kind": "Grouping",
            "description": "L | R | none. Author-controlled position of the label relative to the marker. Use 'none' to hide a single milestone's label without affecting others (per-row hide mechanism)."
        },
        {
            "name": "activityNote",
            "displayName": "Activity Note",
            "kind": "Grouping",
            "description": "Optional per-activity status note (free text). Shown in the activity tooltip on hover. Source: a text column on the Activities table — typically a 'Status' or 'Notes' column."
        },
        {
            "name": "milestoneNote",
            "displayName": "Milestone Note",
            "kind": "Grouping",
            "description": "Optional per-milestone status note (free text). Shown in the milestone tooltip on hover. Source: a text column on the Milestones table."
        },
        {
            "name": "tableActivityRows",
            "displayName": "Activity (Table)",
            "kind": "Grouping",
            "description": "v2.0 — Activity column for the matrix-substrate table region below the Gantt. Each unique value renders as a parent row in the table; matching Milestones (via the Milestone (Table) well) attach as expandable child rows."
        },
        {
            "name": "tableMilestoneRows",
            "displayName": "Milestone (Table)",
            "kind": "Grouping",
            "description": "v2.0 — Milestone column for the matrix-substrate table region. Bound rows become expandable child rows under their parent Activity (Table) row, joined on the matching Activity name."
        },
        {
            "name": "tableValues",
            "displayName": "Values",
            "kind": "Measure",
            "description": "v2.0 — Measures rendered as columns in the matrix-substrate table region. Bind any number of measures (Budget, Actual, %Complete, etc.); each becomes a sortable column with IBCS variance encoding when comparison columns are also bound."
        }
    ],
    "objects": {
        "title": {
            "displayName": "Title",
            "description": "Power BI's built-in platform title. Off by default — use the Chart Title card below instead for richer styling. Turning this on shows the title as a separate text element above the visual viewport (PBI platform handles rendering).",
            "properties": {
                "show":         { "displayName": "Show",        "type": { "bool": true } },
                "text":         { "displayName": "Title text",  "type": { "text": true } },
                "fontColor":    { "displayName": "Color",       "type": { "fill": { "solid": { "color": true } } } },
                "background":   { "displayName": "Background",  "type": { "fill": { "solid": { "color": true } } } },
                "alignment": {
                    "displayName": "Alignment",
                    "type": { "enumeration": [
                        { "value": "left",   "displayName": "Left" },
                        { "value": "center", "displayName": "Center" },
                        { "value": "right",  "displayName": "Right" }
                    ]}
                }
            }
        },
        "chartTitle": {
            "displayName": "Chart Title",
            "description": "Custom title rendered inside the visual at the top — independent from Power BI's built-in 'Title' card. Use this for a styled, presentation-quality title. To avoid two titles, turn the built-in Title card OFF when using Chart Title.",
            "properties": {
                "show":       { "displayName": "Show",        "type": { "bool": true } },
                "text":       { "displayName": "Title text",  "type": { "text": true } },
                "fontColor":  { "displayName": "Color",       "type": { "fill": { "solid": { "color": true } } } },
                "fontFamily": { "displayName": "Font",        "type": { "formatting": { "fontFamily": true } } },
                "fontSize":   { "displayName": "Size",        "type": { "formatting": { "fontSize": true } } },
                "bold":       { "displayName": "Bold",        "type": { "bool": true } },
                "italic":     { "displayName": "Italic",      "type": { "bool": true } },
                "underline":  { "displayName": "Underline",   "type": { "bool": true } },
                "alignment": {
                    "displayName": "Alignment",
                    "type": { "enumeration": [
                        { "value": "left",   "displayName": "Left" },
                        { "value": "center", "displayName": "Center" },
                        { "value": "right",  "displayName": "Right" }
                    ]}
                }
            }
        },
        "tooltip": {
            "displayName": "Tooltip",
            "description": "Controls hover-tooltip behavior. The Note row appears in both activity and milestone tooltips; this card decides whether to show it and how to handle rows where the Note field is unbound or empty.",
            "properties": {
                "showNote":         { "displayName": "Show Note row",            "type": { "bool": true } },
                "hideRowWhenEmpty": { "displayName": "Hide row when no note",    "type": { "bool": true } },
                "emptyPlaceholder": { "displayName": "Placeholder for empty notes", "type": { "text": true } }
            }
        },
        "ganttLayout": {
            "displayName": "Gantt Layout",
            "description": "Outer margins around the Gantt chart region (top half of the composed visual when the table region is also bound). Percentages of viewport.",
            "properties": {
                "topMarginPercent":    { "displayName": "Top margin (%)",    "type": { "numeric": true } },
                "bottomMarginPercent": { "displayName": "Bottom margin (%)", "type": { "numeric": true } },
                "leftMarginPercent":   { "displayName": "Left margin (%)",   "type": { "numeric": true } },
                "rightMarginPercent":  { "displayName": "Right margin (%)",  "type": { "numeric": true } }
            }
        },
        "milestones": {
            "displayName": "Milestones",
            "description": "Marker + label controls. Max 2 milestone types (cap-2). First 2 distinct values from data bind to slots 1 and 2; displayNames in Format pane show actual type names. Data with 3+ types drops the extras.",
            "properties": {
                "hoverExpansion": { "displayName": "Hover target expansion (%)", "type": { "numeric": true } },
                "labelOverflow":  { "displayName": "Label overflow", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide colliding" },
                    { "value": "overflow", "displayName": "Show all (may overlap)" }
                ]}},
                "labelColor":      { "displayName": "Label color",       "type": { "fill": { "solid": { "color": true } } } },
                "labelFontFamily": { "displayName": "Label font",        "type": { "formatting": { "fontFamily": true } } },
                "labelFontSize":   { "displayName": "Label size",        "type": { "formatting": { "fontSize": true } } },
                "labelBold":       { "displayName": "Label bold",        "type": { "bool": true } },
                "labelItalic":     { "displayName": "Label italic",      "type": { "bool": true } },
                "labelUnderline":  { "displayName": "Label underline",   "type": { "bool": true } },
                "type1Color":      { "displayName": "Type 1 color",     "type": { "fill": { "solid": { "color": true } } } },
                "type1Symbol":     { "displayName": "Type 1 symbol",    "type": { "enumeration": [
                    { "value": "star",     "displayName": "Star" },
                    { "value": "circle",   "displayName": "Circle" },
                    { "value": "triangle", "displayName": "Triangle" },
                    { "value": "square",   "displayName": "Square" },
                    { "value": "diamond",  "displayName": "Diamond" }
                ]}},
                "type1Size":       { "displayName": "Type 1 size (px)",  "type": { "numeric": true } },
                "type1ShowMarker": { "displayName": "Type 1 show markers","type": { "bool": true } },
                "type2Color":      { "displayName": "Type 2 color",     "type": { "fill": { "solid": { "color": true } } } },
                "type2Symbol":     { "displayName": "Type 2 symbol",    "type": { "enumeration": [
                    { "value": "star",     "displayName": "Star" },
                    { "value": "circle",   "displayName": "Circle" },
                    { "value": "triangle", "displayName": "Triangle" },
                    { "value": "square",   "displayName": "Square" },
                    { "value": "diamond",  "displayName": "Diamond" }
                ]}},
                "type2Size":       { "displayName": "Type 2 size (px)",  "type": { "numeric": true } },
                "type2ShowMarker": { "displayName": "Type 2 show markers","type": { "bool": true } },
                "legendShow":       { "displayName": "Show legend",       "type": { "bool": true } },
                "legendLabelColor": { "displayName": "Legend label color","type": { "fill": { "solid": { "color": true } } } },
                "legendFontFamily": { "displayName": "Legend font",       "type": { "formatting": { "fontFamily": true } } },
                "legendFontSize":   { "displayName": "Legend size",       "type": { "formatting": { "fontSize": true } } },
                "legendBold":       { "displayName": "Legend bold",       "type": { "bool": true } },
                "legendItalic":     { "displayName": "Legend italic",     "type": { "bool": true } },
                "legendUnderline":  { "displayName": "Legend underline",  "type": { "bool": true } }
            }
        },
        "activityLabels": {
            "displayName": "Activity Labels",
            "properties": {
                "show":                       { "displayName": "Show",                          "type": { "bool": true } },
                "activityLabelWidthPercent":  { "displayName": "Label column width (%)",        "type": { "numeric": true } },
                "wrapText":                   { "displayName": "Wrap (2 lines)",                "type": { "bool": true } },
                "overflowBehavior": { "displayName": "When text doesn't fit", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide" },
                    { "value": "overflow", "displayName": "Show (may overflow)" }
                ]}},
                "fillMode": { "displayName": "Color mode", "type": { "enumeration": [
                    { "value": "grey", "displayName": "Dark grey" },
                    { "value": "area", "displayName": "Swim lane color" }
                ]}},
                "customColor":  { "displayName": "Custom color", "type": { "fill": { "solid": { "color": true } } } },
                "fontFamily":   { "displayName": "Font",        "type": { "formatting": { "fontFamily": true } } },
                "fontSize":     { "displayName": "Size",        "type": { "formatting": { "fontSize": true } } },
                "bold":         { "displayName": "Bold",        "type": { "bool": true } },
                "italic":       { "displayName": "Italic",      "type": { "bool": true } },
                "underline":    { "displayName": "Underline",   "type": { "bool": true } }
            }
        },
        "swimlanes": {
            "displayName": "Swim Lanes",
            "description": "Width, label styling, and per-swim-lane color overrides — all consolidated here. One color picker appears per distinct Swim Lane value found in your data.",
