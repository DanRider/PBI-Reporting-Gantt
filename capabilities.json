                        { "value": "center", "displayName": "Bisect label (center)" },
                        { "value": "right",  "displayName": "Right of label" }
                    ]}
                },
                "wrapText":              { "displayName": "Wrap labels",         "type": { "bool": true } },
                "labelColor":            { "displayName": "Label color (default = swim lane color)", "type": { "fill": { "solid": { "color": true } } } },
                "useAreaColor":          { "displayName": "Use swim lane color for label", "type": { "bool": true } },
                "fontFamily":            { "displayName": "Font",                "type": { "formatting": { "fontFamily": true } } },
                "fontSize":              { "displayName": "Size",                "type": { "formatting": { "fontSize": true } } },
                "bold":                  { "displayName": "Bold",                "type": { "bool": true } },
                "italic":                { "displayName": "Italic",              "type": { "bool": true } },
                "underline":             { "displayName": "Underline",           "type": { "bool": true } },
                "slot1Color":            { "displayName": "Slot 1 color",        "type": { "fill": { "solid": { "color": true } } } },
                "slot2Color":            { "displayName": "Slot 2 color",        "type": { "fill": { "solid": { "color": true } } } },
                "slot3Color":            { "displayName": "Slot 3 color",        "type": { "fill": { "solid": { "color": true } } } },
                "slot4Color":            { "displayName": "Slot 4 color",        "type": { "fill": { "solid": { "color": true } } } },
                "slot5Color":            { "displayName": "Slot 5 color",        "type": { "fill": { "solid": { "color": true } } } },
