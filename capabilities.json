                    ]}
                }
            }
        },
        "appearance": {
            "displayName": "Table — Appearance theme",
            "description": "v2.0 — Built-in appearance theme for the matrix-substrate table region (Bloomberg / Launch / Newsprint / Quartz).",
            "properties": {
                "theme": {
                    "displayName": "Theme",
                    "type": { "enumeration": [
                        { "value": "bloomberg", "displayName": "Bloomberg" },
                        { "value": "launch",    "displayName": "Launch" },
                        { "value": "newsprint", "displayName": "Newsprint" },
                        { "value": "quartz",    "displayName": "Quartz" }
                    ]}
                }
            }
        },
        "columnVisibility": {
            "displayName": "Table — Column visibility",
            "description": "v2.0 — Per-measure column visibility for the matrix-substrate table region. When false the column is excluded from headers, data cells, and the grand total.",
            "properties": {
                "visible": { "displayName": "Visible", "type": { "bool": true } }
            }
        },
        "columnHeaders": {
            "displayName": "Table — Column headers",
            "properties": {
                "groupLabel": {
                    "displayName": "Column group",
                    "description": "Outer-span group label. Consecutive measures sharing the same label cluster under one synthetic header row above the leaves.",
                    "type": { "text": true }
                }
            }
        },
        "columnFavorability": {
            "displayName": "Table — Favorability direction",
            "description": "v2.0 — Per-measure semantic direction for IBCS variance coloring in the matrix-substrate table region. 'higherIsBetter' maps positive variance to the positive color; 'lowerIsBetter' inverts it for cost measures; 'neutral' suppresses coloring.",
            "properties": {
                "direction": {
                    "displayName": "Favorability direction",
                    "type": { "enumeration": [
                        { "value": "higherIsBetter", "displayName": "Higher is better" },
                        { "value": "lowerIsBetter",  "displayName": "Lower is better" },
                        { "value": "neutral",        "displayName": "No coloring" }
                    ]}
                }
            }
        },
        "computedColumns": {
            "displayName": "Table — Computed columns",
            "description": "v2.0 — Period synthesis (MTD/QTD/YTD/FY) and variance (Δ, %Δ) auto-generated columns for the matrix-substrate table region.",
            "properties": {
                "showDelta":     { "displayName": "Show Δ columns",     "type": { "bool": true } },
                "showDeltaPct":  { "displayName": "Show %Δ columns",    "type": { "bool": true } },
                "showMtd":       { "displayName": "Show MTD",           "type": { "bool": true } },
                "showQtd":       { "displayName": "Show QTD",           "type": { "bool": true } },
                "showYtd":       { "displayName": "Show YTD",           "type": { "bool": true } },
                "showFy":        { "displayName": "Show FY",            "type": { "bool": true } },
                "showPriorYear": { "displayName": "Show prior year",    "type": { "bool": true } },
                "fyStartMonth":  { "displayName": "Fiscal year start month (1-12)", "type": { "numeric": true } }
            }
        },
        "ibcs": {
            "displayName": "Table — IBCS variance encoding",
            "description": "v2.0 — IBCS-style variance arrows + color encoding for synthesized Δ and %Δ columns in the matrix-substrate table region.",
            "properties": {
                "enabled":    { "displayName": "Enable IBCS arrows + colors", "type": { "bool": true } },
                "arrowStyle": {
                    "displayName": "Arrow style",
                    "type": { "enumeration": [
                        { "value": "classic", "displayName": "Classic (glyph + color)" },
                        { "value": "minimal", "displayName": "Minimal (color only)" }
                    ]}
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "activity":          { "max": 1 },
                    "area":              { "max": 1 },
                    "startDate":         { "max": 1 },
                    "endDate":           { "max": 1 },
                    "milestoneActivity": { "max": 1 },
                    "milestoneDate":     { "max": 1 },
                    "milestoneType":     { "max": 1 },
                    "milestoneLabel":    { "max": 1 },
                    "labelPosition":     { "max": 1 },
                    "activityNote":      { "max": 1 },
                    "milestoneNote":     { "max": 1 }
                }
