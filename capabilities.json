{
    "dataRoles": [
        {
            "name": "activity",
            "displayName": "Activity",
            "kind": "Grouping",
            "description": "Activity name (PK on the activities table)."
        },
        {
            "name": "area",
            "displayName": "Area",
            "kind": "Grouping",
            "description": "Grouping field — drives swim-lane segmentation. Any text value."
        },
        {
            "name": "startDate",
            "displayName": "Start Date",
            "kind": "Grouping",
            "description": "Activity start date."
        },
        {
            "name": "endDate",
            "displayName": "End Date",
            "kind": "Grouping",
            "description": "Activity end date."
        },
        {
            "name": "milestoneActivity",
            "displayName": "Milestone Activity",
            "kind": "Grouping",
            "description": "FK to the parent activity name."
        },
        {
            "name": "milestoneDate",
            "displayName": "Milestone Date",
            "kind": "Grouping",
            "description": "Milestone date."
        },
        {
            "name": "milestoneType",
            "displayName": "Milestone Type",
            "kind": "Grouping",
            "description": "Milestone classifier — drives marker symbol/color via Format pane (max 2 distinct values rendered; extras dropped with console warning)."
        },
        {
            "name": "milestoneLabel",
            "displayName": "Milestone Label",
            "kind": "Grouping",
            "description": "Optional milestone text (nullable)."
        },
        {
            "name": "labelPosition",
            "displayName": "Label Position",
            "kind": "Grouping",
            "description": "L | R | none. Author-controlled position relative to the marker."
        }
    ],
    "objects": {
        "layout": {
            "displayName": "Layout",
            "properties": {
                "leftRailWidthPercent":      { "displayName": "Left rail width (%)",     "type": { "numeric": true } },
                "activityLabelWidthPercent": { "displayName": "Activity label width (%)","type": { "numeric": true } },
                "rightMarginPercent":        { "displayName": "Right margin (%)",        "type": { "numeric": true } }
            }
        },
        "areaColors": {
            "displayName": "Area Colors",
            "description": "Color override per distinct Area value. Defaults derive from the report theme palette.",
            "properties": {
                "fill": {
                    "displayName": "Color",
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "milestones": {
            "displayName": "Milestones",
            "description": "Marker shape, size, color, and visibility per type slot. Max 2 milestone types rendered; first 2 distinct values from data are bound to slots 1 and 2.",
            "properties": {
                "type1Color": {
                    "displayName": "Slot 1 color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "type1Symbol": {
                    "displayName": "Slot 1 symbol",
                    "type": { "enumeration": [
                        { "value": "star",     "displayName": "Star" },
                        { "value": "circle",   "displayName": "Circle" },
                        { "value": "triangle", "displayName": "Triangle" },
                        { "value": "square",   "displayName": "Square" },
                        { "value": "diamond",  "displayName": "Diamond" }
                    ]}
                },
                "type1Size":       { "displayName": "Slot 1 size (px)",  "type": { "numeric": true } },
                "type1ShowMarker": { "displayName": "Slot 1 markers",    "type": { "bool": true } },
                "type1ShowLabel":  { "displayName": "Slot 1 labels",     "type": { "bool": true } },
                "type2Color": {
                    "displayName": "Slot 2 color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "type2Symbol": {
                    "displayName": "Slot 2 symbol",
                    "type": { "enumeration": [
                        { "value": "star",     "displayName": "Star" },
                        { "value": "circle",   "displayName": "Circle" },
                        { "value": "triangle", "displayName": "Triangle" },
                        { "value": "square",   "displayName": "Square" },
                        { "value": "diamond",  "displayName": "Diamond" }
                    ]}
                },
                "type2Size":       { "displayName": "Slot 2 size (px)",  "type": { "numeric": true } },
                "type2ShowMarker": { "displayName": "Slot 2 markers",    "type": { "bool": true } },
                "type2ShowLabel":  { "displayName": "Slot 2 labels",     "type": { "bool": true } },
                "hoverExpansion":  { "displayName": "Hover target expansion (%)", "type": { "numeric": true } }
            }
        },
        "activityLabels": {
            "displayName": "Activity Labels",
            "properties": {
                "show":      { "displayName": "Show",            "type": { "bool": true } },
                "wrapText":  { "displayName": "Wrap (2 lines)",  "type": { "bool": true } },
                "overflowBehavior": { "displayName": "When text doesn't fit", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide" },
                    { "value": "overflow", "displayName": "Show (may overflow)" }
                ]}},
                "fillMode":  { "displayName": "Color mode", "type": { "enumeration": [
                    { "value": "grey", "displayName": "Dark grey" },
                    { "value": "area", "displayName": "Area color" }
                ]}},
                "customColor": { "displayName": "Custom color", "type": { "fill": { "solid": { "color": true } } } },
                "fontSize":    { "displayName": "Font size",   "type": { "numeric": true } }
            }
        },
        "milestoneLabels": {
            "displayName": "Milestone Labels",
            "properties": {
                "overflowBehavior": { "displayName": "When labels collide", "type": { "enumeration": [
                    { "value": "truncate", "displayName": "Truncate with …" },
                    { "value": "hide",     "displayName": "Hide colliding" },
                    { "value": "overflow", "displayName": "Show all (may overlap)" }
                ]}},
                "fontSize":  { "displayName": "Font size",   "type": { "numeric": true } },
                "labelColor":{ "displayName": "Label color", "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "swimlanes": {
            "displayName": "Swim Lanes",
            "properties": {
                "show":      { "displayName": "Show", "type": { "bool": true } },
                "wrapText":  { "displayName": "Wrap area labels", "type": { "bool": true } }
            }
        },
        "legend": {
            "displayName": "Legend",
            "properties": {
                "show":      { "displayName": "Show (upper-left)", "type": { "bool": true } }
            }
        },
        "timeAxis": {
            "displayName": "Time Axis",
            "properties": {
                "showTodayLine":            { "displayName": "TODAY line",                "type": { "bool": true } },
                "showTodayLabel":           { "displayName": "TODAY label",               "type": { "bool": true } },
                "todayLabelColor":          { "displayName": "TODAY color",               "type": { "fill": { "solid": { "color": true } } } },
                "showPastShading":          { "displayName": "Past shading",              "type": { "bool": true } },
                "pastShadingColor":         { "displayName": "Past shading color",        "type": { "fill": { "solid": { "color": true } } } },
                "pastShadingOpacityPct":    { "displayName": "Past shading opacity (%)",  "type": { "numeric": true } },
                "showFutureShading":        { "displayName": "Future shading",            "type": { "bool": true } },
                "futureShadingColor":       { "displayName": "Future shading color",      "type": { "fill": { "solid": { "color": true } } } },
                "futureShadingOpacityPct":  { "displayName": "Future shading opacity (%)","type": { "numeric": true } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "activity":          { "max": 1 },
                    "area":              { "max": 1 },
                    "startDate":         { "max": 1 },
                    "endDate":           { "max": 1 },
                    "milestoneActivity": { "max": 1 },
                    "milestoneDate":     { "max": 1 },
                    "milestoneType":     { "max": 1 },
                    "milestoneLabel":    { "max": 1 },
                    "labelPosition":     { "max": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "activity" } },
                        { "for": { "in": "area" } },
                        { "for": { "in": "startDate" } },
                        { "for": { "in": "endDate" } },
                        { "for": { "in": "milestoneActivity" } },
                        { "for": { "in": "milestoneDate" } },
                        { "for": { "in": "milestoneType" } },
                        { "for": { "in": "milestoneLabel" } },
                        { "for": { "in": "labelPosition" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": { "count": 5000 }
                    }
                }
            }
        }
    ],
    "supportsHighlight": false,
    "supportsLandingPage": false,
    "supportsMultiVisualSelection": false,
    "privileges": []
}
