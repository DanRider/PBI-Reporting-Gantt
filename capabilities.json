{
    "dataRoles": [
        {
            "name": "activity",
            "displayName": "Activity",
            "kind": "Grouping",
            "description": "The bar's identity. Each unique value renders as one horizontal bar (e.g., a project task, a campaign phase, a product release, an audit cycle)."
        },
        {
            "name": "area",
            "displayName": "Swim Lane",
            "kind": "Grouping",
            "description": "Optional grouping that segments bars into swim lanes (e.g., team, department, workstream, portfolio area)."
        },
        {
            "name": "startDate",
            "displayName": "Start Date",
            "kind": "Grouping",
            "description": "When the bar starts. Date column."
        },
        {
            "name": "endDate",
            "displayName": "End Date",
            "kind": "Grouping",
            "description": "When the bar ends. Date column."
        },
        {
            "name": "milestoneActivity",
            "displayName": "Milestone Activity",
            "kind": "Grouping",
            "description": "FK to the parent activity name. Each milestone attaches to the bar with the matching name."
        },
        {
            "name": "milestoneDate",
            "displayName": "Milestone Date",
            "kind": "Grouping",
            "description": "When the milestone marker is placed on its parent bar."
        },
        {
            "name": "milestoneType",
            "displayName": "Milestone Type",
            "kind": "Grouping",
            "description": "Marker classifier \u2014 distinct values appear as one slice each in the Format pane (color/symbol/size/visibility per type)."
        },
        {
            "name": "milestoneLabel",
            "displayName": "Milestone Label",
            "kind": "Grouping",
            "description": "Optional milestone text (nullable). Shown next to the marker per Label Position."
        },
        {
            "name": "labelPosition",
            "displayName": "Label Position",
            "kind": "Grouping",
            "description": "L | R | none. Author-controlled position of the label relative to the marker. Use 'none' to hide a single milestone's label without affecting others (per-row hide mechanism)."
        },
        {
            "name": "activityNote",
            "displayName": "Activity Note",
            "kind": "Grouping",
            "description": "Optional per-activity status note (free text). Shown in the activity tooltip on hover. Source: a text column on the Activities table \u2014 typically a 'Status' or 'Notes' column."
        },
        {
            "name": "milestoneNote",
            "displayName": "Milestone Note",
            "kind": "Grouping",
            "description": "Optional per-milestone status note (free text). Shown in the milestone tooltip on hover. Source: a text column on the Milestones table."
        }
    ],
