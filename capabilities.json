        "themeColors": {
            "displayName": "Table — Theme Colors",
            "description": "v2.0 — Color overrides for the matrix-substrate table region (bottom half of the composed visual). Active appearance theme is the default; each override here is layered on top.",
            "properties": {
                "headerBg": { "displayName": "Header background", "type": { "fill": { "solid": { "color": true } } } },
                "headerFg": { "displayName": "Header text",       "type": { "fill": { "solid": { "color": true } } } },
                "bodyFg":   { "displayName": "Body text",         "type": { "fill": { "solid": { "color": true } } } },
                "borderFg": { "displayName": "Border",            "type": { "fill": { "solid": { "color": true } } } },
                "altRowBg": { "displayName": "Alternate row background", "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "totals": {
            "displayName": "Table — Totals",
            "description": "v2.0 — Grand-total row for the matrix-substrate table region.",
            "properties": {
                "showGrandTotal": { "displayName": "Show grand total", "type": { "bool": true } }
            }
        },
        "tableLayout": {
            "displayName": "Table Layout",
            "description": "v2.0 — Row height, body font size, denomination, decimal places, and K/M letter suffix for the matrix-substrate table region.",
            "properties": {
                "rowHeight":    { "displayName": "Row height (px)",   "type": { "numeric": true } },
                "bodyFontSize": { "displayName": "Body font size (px)", "type": { "numeric": true } },
                "denomination": {
                    "displayName": "Denomination",
                    "type": { "enumeration": [
                        { "value": "dollars",   "displayName": "Dollars" },
                        { "value": "thousands", "displayName": "Thousands (K)" },
                        { "value": "millions",  "displayName": "Millions (M)" }
                    ]}
                },
                "decimals":   { "displayName": "Decimal places", "type": { "numeric": true } },
                "showLetter": { "displayName": "Append K/M letter", "type": { "bool": true } }
            }
        },
        "reportingDate": {
            "displayName": "Table — Reporting date",
            "description": "v2.0 — Reporting month anchor (YYYY-MM-DD) used by the matrix-substrate table region for MTD/QTD/YTD/FY period synthesis.",
            "properties": {
                "selectedDate": { "displayName": "Reporting month (YYYY-MM-DD)", "type": { "text": true } }
            }
        },
        "compareAgainst": {
            "displayName": "Table — Compare against",
            "description": "v2.0 — Comparison mode for IBCS variance encoding in the matrix-substrate table region.",
            "properties": {
                "mode": {
                    "displayName": "Mode",
                    "type": { "enumeration": [
                        { "value": "priorYear",          "displayName": "Prior year (AvA)" },
                        { "value": "budget",             "displayName": "Budget (BvA)" },
